IDI_ICON1 ICON DISCARDABLE "ui/resources/gridsmall.ico"

#include <windows.h>
#include "appversion.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     _PVER_FILEVERSION
PRODUCTVERSION  _PVER_PRODUCTVERSION
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",        _PVER_COMPANYNAME_STR
            VALUE "FileDescription",    _PVER_FILEDESCRIPTION_STR
            VALUE "FileVersion",        _PVER_FILEVERSION_STR
            VALUE "InternalName",       _PVER_INTERNALNAME_STR
            VALUE "LegalCopyright",     _PVER_LEGALCOPYRIGHT_STR
            VALUE "LegalTrademarks1",   _PVER_LEGALTRADEMARKS1_STR
            VALUE "LegalTrademarks2",   _PVER_LEGALTRADEMARKS2_STR
            VALUE "OriginalFilename",   _PVER_ORIGINALFILENAME_STR
            VALUE "ProductName",        _PVER_PRODUCTNAME_STR
            VALUE "ProductVersion",     _PVER_PRODUCTVERSION_STR
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
